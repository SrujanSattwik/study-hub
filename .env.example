# KnowNook / StudyHub Production Environment Variables Reference

# Application Configuration
NODE_ENV=production
PORT=5000
APP_VERSION=v1.0.0

# Database Configuration (PostgreSQL 16)
DATABASE_URL="postgresql://user:password@localhost:5432/study_hub?schema=public"

# Authentication Secrets
JWT_SECRET="super-secret-jwt-key-replace-in-production"
JWT_EXPIRES_IN="7d"

# Gemini AI API Integration
GEMINI_API_KEY="your-gemini-api-key-here"

# CORS Allowed Origins (Comma-separated)
ALLOWED_ORIGINS="http://localhost:5173,http://localhost:5000,https://studyhub.domain.com"
